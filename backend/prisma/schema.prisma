datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerStatus {
  LEAD_MOI
  DANG_TIEP_CAN
  DANG_TU_VAN
  THANH_CONG
  KHONG_KHA_THI
}

enum PriorityLevel {
  CHUA_CO_NHU_CAU
  THANH_KHOAN
  TIN_DUNG
  THANH_KHOAN_TIN_DUNG
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DROPPED
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum CaseProgress {
  NOT_SELECTED
  REGISTRATION_CREATED
  REGISTRATION_COMPLETED
  UNDER_REVIEW
  APPROVED
  CARD_ISSUED
  CARD_ACTIVATED
  COMPLETED
}

enum ActivityType {
  CONTACT
  CALL
  MESSAGE
  MEETING
  APPLICATION_CREATED
  APPLICATION_UPDATED
  STATUS_CHANGED
  NEED_DETECTED
  FOLLOW_UP
  PUSH_CREATED
  PUSH_RESULT
  NOTE_CREATED
  SYSTEM_EVENT
  PUSH_SENT
  NOTE
  CREATE_CASE
  SELECT_PRODUCT
  PROGRESS_CHANGED
  REJECTED
  APPROVED
  CARD_ISSUED
  CARD_ACTIVATED
  COMPLETED
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecommendationStatus {
  NEW
  REVIEWED
  DISMISSED
  CONVERTED_TO_PUSH
  ACTIVE
  ACCEPTED
  EXPIRED
}

enum PushStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  CANCELLED
}

enum ProductCategory {
  LOAN_UNSECURED
  LOAN_SECURED
  CREDIT_CARD
  INSURANCE
  SAVINGS
  OTHER
}

enum InterestRateUnit {
  PERCENT_PER_YEAR
  PERCENT_PER_MONTH
}

model CustomerSource {
  id          String     @id @default(uuid())
  name        String     @unique @map("name")
  active      Boolean    @default(true) @map("active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  customers   Customer[]

  @@map("customer_sources")
}

model Customer {
  id              String            @id @default(uuid())
  fullName        String            @map("full_name")
  phone           String            @map("phone")
  email           String?           @map("email")
  gender          Gender?           @map("gender")
  dateOfBirth     DateTime?         @map("date_of_birth")
  address         String?           @map("address")
  note            String?           @map("note") @db.Text
  source          String?           @map("source")
  sourceId        String?           @map("source_id")
  overallStatus   CustomerStatus    @default(LEAD_MOI) @map("overall_status")
  priority        PriorityLevel?    @default(CHUA_CO_NHU_CAU) @map("priority")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customerSource  CustomerSource?   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  needs           CustomerNeed[]
  cases           CustomerCase[]
  activities      CustomerActivity[]
  notes           CustomerNote[]
  customerTags    CustomerTag[]
  followUps       FollowUp[]
  recommendations Recommendation[]
  pushRecords     PushRecord[]
  assignments     CustomerAssignment[]
  assignmentGrants CustomerAssignmentGrant[]
  assessments     Assessment[]
  assessmentRuns  AssessmentRecommendationRun[]
  akinatorSessions AkinatorSession[] @relation("CustomerAkinatorSessions")

  @@index([phone])
  @@index([sourceId])
  @@index([overallStatus])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("customers")
}

model Product {
  id              String                  @id @default(uuid())
  code            String                  @unique @map("code")
  name            String                  @map("name")
  description     String?                 @map("description") @db.Text
  active          Boolean                 @default(true) @map("active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  financialDetail ProductFinancialDetail?
  cases           CustomerCase[]
  recommendations Recommendation[]
  pushRecords     PushRecord[]
  assessmentRecommendationItems AssessmentRecommendationItem[]

  @@map("products")
}

model ProductFinancialDetail {
  id                  String           @id @default(uuid())
  productId           String           @unique @map("product_id")
  category            ProductCategory  @default(OTHER) @map("category")
  providerName        String?          @map("provider_name")
  minAmount           Decimal?         @map("min_amount") @db.Decimal(15, 2)
  maxAmount           Decimal?         @map("max_amount") @db.Decimal(15, 2)
  minInterestRate     Decimal?         @map("min_interest_rate") @db.Decimal(5, 2)
  maxInterestRate     Decimal?         @map("max_interest_rate") @db.Decimal(5, 2)
  interestRateUnit    InterestRateUnit @default(PERCENT_PER_YEAR) @map("interest_rate_unit")
  minTenureMonths     Int?             @map("min_tenure_months")
  maxTenureMonths     Int?             @map("max_tenure_months")
  feesDescription     String?          @map("fees_description") @db.Text
  minAge              Int?             @map("min_age")
  maxAge              Int?             @map("max_age")
  minIncome           Decimal?         @map("min_income") @db.Decimal(15, 2)
  acceptBadDebt       Boolean          @default(false) @map("accept_bad_debt")
  eligibilityCriteria Json?            @map("eligibility_criteria")
  benefits            Json?            @map("benefits")
  risks               Json?            @map("risks")
  officialUrl         String?          @map("official_url") @db.VarChar(500)
  effectiveFrom       DateTime?        @map("effective_from")
  effectiveTo         DateTime?        @map("effective_to")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([providerName])
  @@map("product_financial_details")
}

model CustomerNeed {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  needType        String            @map("need_type")
  status          NeedStatus        @default(OPEN) @map("status")
  detectedAt      DateTime          @default(now()) @map("detected_at")
  resolvedAt      DateTime?         @map("resolved_at")
  notes           String?           @map("notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("customer_needs")
}

model CustomerCase {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  productId       String?           @map("product_id")
  caseStatus      CaseStatus        @default(ACTIVE) @map("case_status")
  progress        CaseProgress      @default(NOT_SELECTED) @map("progress")
  applicationDate DateTime?         @map("application_date")
  resultDate      DateTime?         @map("result_date")
  rejectedAt      DateTime?         @map("rejected_at")
  rejectionReason String?           @map("rejection_reason") @db.Text
  rejectionNote   String?           @map("rejection_note") @db.Text
  failureReason   String?           @map("failure_reason") @db.Text
  notes           String?           @map("notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  progressHistory CaseProgressHistory[]

  @@index([customerId])
  @@index([productId])
  @@index([caseStatus])
  @@index([progress])
  @@index([createdAt])
  @@map("customer_cases")
}

model CaseProgressHistory {
  id           String        @id @default(uuid())
  caseId       String        @map("case_id")
  fromProgress CaseProgress? @map("from_progress")
  toProgress   CaseProgress  @map("to_progress")
  changedAt    DateTime      @default(now()) @map("changed_at")
  note         String?       @map("note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  case         CustomerCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([toProgress])
  @@index([changedAt])
  @@map("case_progress_histories")
}

model CustomerActivity {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  type            ActivityType      @map("type")
  title           String            @map("title")
  description     String?           @map("description") @db.Text
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([occurredAt])
  @@map("customer_activities")
}

model CustomerNote {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  content         String            @map("content") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

model Tag {
  id              String            @id @default(uuid())
  name            String            @unique @map("name")
  color           String?           @map("color")
  createdAt       DateTime          @default(now()) @map("created_at")

  customerTags    CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId      String            @map("customer_id")
  tagId           String            @map("tag_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag             Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

model FollowUp {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  title           String            @map("title")
  description     String?           @map("description") @db.Text
  dueAt           DateTime          @map("due_at")
  status          FollowUpStatus    @default(PENDING) @map("status")
  completedAt     DateTime?         @map("completed_at")
  assignedTo      String?           @map("assigned_to")
  assignedToUserId String?          @map("assigned_to_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToUser  User?             @relation("UserAssignedFollowUps", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([dueAt])
  @@index([status])
  @@index([assignedToUserId])
  @@map("follow_ups")
}

model Recommendation {
  id                 String               @id @default(uuid())
  customerId         String               @map("customer_id")
  targetProductId    String?              @map("target_product_id")
  recommendationType String               @map("recommendation_type")
  score              Decimal?             @map("score") @db.Decimal(5, 2)
  reason             String               @map("reason") @db.Text
  status             RecommendationStatus @default(NEW) @map("status")
  generatedAt        DateTime             @default(now()) @map("generated_at")
  dismissedAt        DateTime?            @map("dismissed_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  targetProduct      Product?             @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  pushRecords        PushRecord[]

  @@index([customerId])
  @@index([targetProductId])
  @@index([status])
  @@map("recommendations")
}

model PushRecord {
  id                 String            @id @default(uuid())
  customerId         String            @map("customer_id")
  recommendationId   String?           @map("recommendation_id")
  targetProductId    String?           @map("target_product_id")
  pushedAt           DateTime          @default(now()) @map("pushed_at")
  status             PushStatus        @default(PENDING) @map("status")
  resultAt           DateTime?         @map("result_at")
  failureReason      String?           @map("failure_reason") @db.Text
  note               String?           @map("note") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recommendation     Recommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  targetProduct      Product?          @relation(fields: [targetProductId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([targetProductId])
  @@index([recommendationId])
  @@index([status])
  @@index([pushedAt])
  @@map("push_records")
}

model PushSubscription {
  id         String   @id @default(uuid())
  recipient  String   @map("recipient")
  endpoint   String   @unique @map("endpoint") @db.VarChar(500)
  p256dh     String   @map("p256dh") @db.VarChar(255)
  auth       String   @map("auth") @db.VarChar(255)
  deviceName String?  @map("device_name")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([recipient])
  @@map("push_subscriptions")
}

model PushNotificationLog {
  id           String   @id @default(uuid())
  followUpId   String?  @map("follow_up_id")
  eventType    String   @map("event_type")
  recipient    String   @map("recipient")
  status       String   @default("SENT") @map("status")
  title        String   @map("title")
  body         String?  @map("body") @db.Text
  errorMessage String?  @map("error_message") @db.Text
  sentAt       DateTime @default(now()) @map("sent_at")

  @@unique([followUpId, eventType, recipient])
  @@index([followUpId])
  @@index([recipient])
  @@index([sentAt])
  @@map("push_notification_logs")
}

model Caretaker {
  id        String   @id @default(uuid())
  name      String   @unique @map("name")
  active    Boolean  @default(true) @map("active")
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("caretakers")
}

enum Role {
  ADMIN
  PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @map("email")
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         Role       @default(PARTNER) @map("role")
  status       UserStatus @default(ACTIVE) @map("status")
  phone        String?    @map("phone")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignedCustomers  CustomerAssignment[] @relation("AssignedPartner")
  createdAssignments CustomerAssignment[] @relation("AssignedByAdmin")
  receivedGrants     CustomerAssignmentGrant[] @relation("PartnerAssignmentGrants")
  createdGrants      CustomerAssignmentGrant[] @relation("AdminAssignmentGrants")
  auditLogs          AuditLog[]
  caretaker          Caretaker?
  assignedFollowUps  FollowUp[] @relation("UserAssignedFollowUps")
  performedAssessments Assessment[] @relation("UserPerformedAssessments")
  performedRecommendationRuns AssessmentRecommendationRun[] @relation("UserPerformedRecommendationRuns")
  createdSurveyLinks  PublicSurveyLink[] @relation("UserCreatedSurveyLinks")
  revokedSurveyLinks  PublicSurveyLink[] @relation("UserRevokedSurveyLinks")
  createdAkinatorSessions AkinatorSession[] @relation("UserCreatedAkinatorSessions")
  revokedAkinatorSessions AkinatorSession[] @relation("UserRevokedAkinatorSessions")

  @@map("users")
}

model CustomerAssignment {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  userId       String   @map("user_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  notes        String?  @map("notes") @db.Text

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("AssignedPartner", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssignedByAdmin", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([customerId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("customer_assignments")
}

enum AssignmentSourceType {
  DIRECT
  CARE_SCHEDULE
}

model CustomerAssignmentGrant {
  id           String               @id @default(uuid())
  customerId   String               @map("customer_id")
  userId       String               @map("user_id")
  sourceType   AssignmentSourceType @map("source_type")
  sourceId     String               @default("DIRECT") @map("source_id")
  active       Boolean              @default(true) @map("active")
  assignedById String?              @map("assigned_by_id")
  notes        String?              @map("notes") @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("PartnerAssignmentGrants", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AdminAssignmentGrants", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([customerId, userId, sourceType, sourceId], name: "customer_user_source_unique")
  @@index([userId])
  @@index([customerId])
  @@index([sourceId])
  @@index([active])
  @@map("customer_assignment_grants")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?  @map("details") @db.Text
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================================
// PHASE 2: DYNAMIC QUESTIONNAIRE & QUESTIONNAIRE VERSIONING
// =========================================================================

enum QuestionnaireVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER
  CURRENCY
  TEXT
  LONG_TEXT
  DATE
}

model Questionnaire {
  id          String                 @id @default(uuid())
  code        String                 @unique @map("code")
  title       String                 @map("title")
  description String?                @map("description") @db.Text
  active      Boolean                @default(true) @map("active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  versions    QuestionnaireVersion[]

  @@map("questionnaires")
}

model QuestionnaireVersion {
  id              String                     @id @default(uuid())
  questionnaireId String                     @map("questionnaire_id")
  versionNumber   Int                        @map("version_number")
  status          QuestionnaireVersionStatus @default(DRAFT) @map("status")
  isCurrent       Boolean                    @default(false) @map("is_current")
  title           String?                    @map("title")
  description     String?                    @map("description") @db.Text
  changeLog       String?                    @map("change_log") @db.Text
  publishedAt     DateTime?                  @map("published_at")
  publishedBy     String?                    @map("published_by")
  createdBy       String?                    @map("created_by")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  questionnaire   Questionnaire              @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questions       QuestionDefinition[]
  assessments     Assessment[]

  @@unique([questionnaireId, versionNumber])
  @@index([questionnaireId])
  @@index([status])
  @@index([isCurrent])
  @@map("questionnaire_versions")
}

model QuestionDefinition {
  id                String               @id @default(uuid())
  versionId         String               @map("version_id")
  code              String               @map("code")
  questionText      String               @map("question_text") @db.Text
  description       String?              @map("description") @db.Text
  questionType      QuestionType         @map("question_type")
  isRequired        Boolean              @default(false) @map("is_required")
  displayOrder      Int                  @default(0) @map("display_order")
  options           Json?                @map("options")
  validationConfig  Json?                @map("validation_config")
  conditionalLogic  Json?                @map("conditional_logic")
  active            Boolean              @default(true) @map("active")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  version           QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, code])
  @@index([versionId])
  @@index([displayOrder])
  @@map("question_definitions")
}

// =========================================================================
// PHASE 3: CUSTOMER NEEDS ASSESSMENT & ANSWER STORAGE
// =========================================================================

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Assessment {
  id                     String               @id @default(uuid())
  customerId             String               @map("customer_id")
  questionnaireVersionId String               @map("questionnaire_version_id")
  status                 AssessmentStatus     @default(IN_PROGRESS) @map("status")
  performedById          String?              @map("performed_by_id")
  startedAt              DateTime             @default(now()) @map("started_at")
  completedAt            DateTime?            @map("completed_at")
  notes                  String?              @map("notes") @db.Text
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  customer               Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  performedBy            User?                @relation("UserPerformedAssessments", fields: [performedById], references: [id], onDelete: SetNull)
  answers                AssessmentAnswer[]
  recommendationRuns     AssessmentRecommendationRun[]
  publicSurveyLink       PublicSurveyLink?

  @@index([customerId])
  @@index([questionnaireVersionId])
  @@index([status])
  @@index([startedAt])
  @@map("assessments")
}

model AssessmentAnswer {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  questionId   String?    @map("question_id")
  questionCode String     @map("question_code")
  answerValue  Json       @map("answer_value")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionCode], name: "assessment_question_unique")
  @@index([assessmentId])
  @@index([questionCode])
  @@map("assessment_answers")
}

// =========================================================================
// PHASE 4: DETERMINISTIC & EXPLAINABLE RECOMMENDATION ENGINE
// =========================================================================

enum RuleVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RecommendationRunStatus {
  COMPLETED
  FAILED
}

model AssessmentRecommendationRuleSet {
  id          String                                @id @default(uuid())
  code        String                                @unique @map("code")
  title       String                                @map("title")
  description String?                               @map("description") @db.Text
  active      Boolean                               @default(true) @map("active")
  createdAt   DateTime                              @default(now()) @map("created_at")
  updatedAt   DateTime                              @updatedAt @map("updated_at")

  versions    AssessmentRecommendationRuleVersion[]

  @@map("assessment_recommendation_rule_sets")
}

model AssessmentRecommendationRuleVersion {
  id            String                          @id @default(uuid())
  ruleSetId     String                          @map("rule_set_id")
  versionNumber Int                             @map("version_number")
  status        RuleVersionStatus               @default(DRAFT) @map("status")
  isCurrent     Boolean                         @default(false) @map("is_current")
  rules         Json                            @map("rules")
  changeLog     String?                         @map("change_log") @db.Text
  publishedAt   DateTime?                       @map("published_at")
  publishedBy   String?                         @map("published_by")
  createdBy     String?                         @map("created_by")
  createdAt     DateTime                        @default(now()) @map("created_at")
  updatedAt     DateTime                        @updatedAt @map("updated_at")

  ruleSet       AssessmentRecommendationRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  runs          AssessmentRecommendationRun[]

  @@unique([ruleSetId, versionNumber])
  @@index([ruleSetId])
  @@index([status])
  @@index([isCurrent])
  @@map("assessment_recommendation_rule_versions")
}

model AssessmentRecommendationRun {
  id                       String                              @id @default(uuid())
  customerId               String                              @map("customer_id")
  assessmentId             String                              @map("assessment_id")
  ruleVersionId            String                              @map("rule_version_id")
  performedById            String?                             @map("performed_by_id")
  status                   RecommendationRunStatus             @default(COMPLETED) @map("status")
  answersSnapshot          Json                                @map("answers_snapshot")
  rulesSnapshot            Json                                @map("rules_snapshot")
  totalCandidatesEvaluated Int                                 @default(0) @map("total_candidates_evaluated")
  totalRecommended         Int                                 @default(0) @map("total_recommended")
  executionTimeMs          Int?                                @map("execution_time_ms")
  notes                    String?                             @map("notes") @db.Text
  createdAt                DateTime                            @default(now()) @map("created_at")

  customer                 Customer                            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assessment               Assessment                          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  ruleVersion              AssessmentRecommendationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  performedBy              User?                               @relation("UserPerformedRecommendationRuns", fields: [performedById], references: [id], onDelete: SetNull)
  items                    AssessmentRecommendationItem[]

  @@index([customerId])
  @@index([assessmentId])
  @@index([ruleVersionId])
  @@index([createdAt])
  @@map("assessment_recommendation_runs")
}

model AssessmentRecommendationItem {
  id                 String                      @id @default(uuid())
  runId              String                      @map("run_id")
  productId          String                      @map("product_id")
  productName        String                      @map("product_name")
  productCode        String                      @map("product_code")
  productCategory    ProductCategory             @map("product_category")
  productSnapshot    Json                        @map("product_snapshot")
  score              Decimal                     @map("score") @db.Decimal(5, 2)
  rank               Int                         @default(1) @map("rank")
  confidence         Int                         @default(100) @map("confidence")
  isEligible         Boolean                     @default(true) @map("is_eligible")
  matchSummary       String                      @map("match_summary") @db.Text
  passedCriteria     Json                        @map("passed_criteria")
  failedCriteria     Json                        @map("failed_criteria")
  unassessedCriteria Json                        @map("unassessed_criteria")
  warnings           Json                        @map("warnings")
  answersUsed        Json                        @map("answers_used")
  createdAt          DateTime                    @default(now()) @map("created_at")

  run                AssessmentRecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product            Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([runId, productId], name: "run_product_unique")
  @@index([runId])
  @@index([productId])
  @@index([score])
  @@index([isEligible])
  @@map("assessment_recommendation_items")
}

// =========================================================================
// PHASE PUBLIC SURVEY: PUBLIC LINK FOR CUSTOMER SELF-SERVICE QUESTIONNAIRE
// =========================================================================

enum PublicSurveyLinkStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REVOKED
}

model PublicSurveyLink {
  id             String                 @id @default(uuid())
  /// SHA-256 hash of the raw token (never store raw token)
  tokenHash      String                 @unique @map("token_hash") @db.VarChar(64)
  assessmentId   String                 @unique @map("assessment_id")
  createdById    String?                @map("created_by_id")
  status         PublicSurveyLinkStatus @default(ACTIVE) @map("status")
  expiresAt      DateTime               @map("expires_at")
  revokedAt      DateTime?              @map("revoked_at")
  revokedById    String?                @map("revoked_by_id")
  completedAt    DateTime?              @map("completed_at")
  lastAccessedAt DateTime?              @map("last_accessed_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy      User?                  @relation("UserCreatedSurveyLinks", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy      User?                  @relation("UserRevokedSurveyLinks", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([assessmentId])
  @@index([status])
  @@index([expiresAt])
  @@map("public_survey_links")
}

// =========================================================================
// ISOLATED AKINATOR MODULE: ADAPTIVE QUIZ, RULE ENGINE & ADMIN REVIEW
// =========================================================================

enum AkinatorConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AkinatorQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER
  CURRENCY
  TEXT
  DATE
}

enum AkinatorCustomerFieldMapping {
  NONE
  FULL_NAME
  PHONE
  EMAIL
  DOB
  GENDER
  ADDRESS
}

enum AkinatorSessionSourceType {
  PUBLIC_WALK_IN
  CRM_CUSTOMER_LINK
}

enum AkinatorQuizStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
  REVOKED
}

enum AkinatorWorkflowStatus {
  PENDING_PROCESSING
  IN_PROGRESS
  NEEDS_MORE_INFO
  PENDING_APPROVAL
  APPROVED
  TRANSFERRED
  REJECTED
}

enum AkinatorEvaluationStatus {
  EVALUATED
  INSUFFICIENT_DATA
}

model AkinatorConfigVersion {
  id                     String               @id @default(uuid())
  versionNumber          Int                  @unique @map("version_number")
  title                  String               @map("title")
  description            String?              @map("description") @db.Text
  status                 AkinatorConfigStatus @default(DRAFT) @map("status")
  isCurrent              Boolean              @default(false) @map("is_current")
  maxQuestionsPerSession Int                  @default(15) @map("max_questions_per_session")
  disclaimerText         String               @map("disclaimer_text") @db.Text
  changeLog              String?              @map("change_log") @db.Text
  publishedAt            DateTime?            @map("published_at")
  publishedById          String?              @map("published_by_id")
  createdById            String?              @map("created_by_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  questions              AkinatorQuestion[]
  rules                  AkinatorRule[]
  sessions               AkinatorSession[]

  @@index([status])
  @@index([isCurrent])
  @@map("akinator_config_versions")
}

model AkinatorQuestion {
  id                   String                       @id @default(uuid())
  configVersionId      String                       @map("config_version_id")
  code                 String                       @map("code")
  questionText         String                       @map("question_text") @db.Text
  description          String?                      @map("description") @db.Text
  questionType         AkinatorQuestionType         @map("question_type")
  isEntryQuestion      Boolean                      @default(false) @map("is_entry_question")
  isRequiredForEval    Boolean                      @default(false) @map("is_required_for_eval")
  priorityWeight       Int                          @default(50) @map("priority_weight")
  mapsToCustomerField  AkinatorCustomerFieldMapping @default(NONE) @map("maps_to_customer_field")
  options              Json?                        @map("options")
  validationConfig     Json?                        @map("validation_config")
  visibilityConditions Json?                        @map("visibility_conditions")
  nextQuestionRules    Json?                        @map("next_question_rules")
  active               Boolean                      @default(true) @map("active")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  configVersion        AkinatorConfigVersion        @relation(fields: [configVersionId], references: [id], onDelete: Cascade)
  rawAnswers           AkinatorRawAnswer[]

  @@unique([configVersionId, code], name: "akinator_version_question_code_unique")
  @@index([configVersionId])
  @@index([priorityWeight])
  @@map("akinator_questions")
}

model AkinatorRule {
  id                    String                @id @default(uuid())
  configVersionId       String                @map("config_version_id")
  code                  String                @map("code")
  name                  String                @map("name")
  description           String?               @map("description") @db.Text
  priorityOrder         Int                   @default(1) @map("priority_order")
  requiredQuestionCodes Json                  @map("required_question_codes")
  conditions            Json                  @map("conditions")
  outcomePayload        Json                  @map("outcome_payload")
  stopOnMatch           Boolean               @default(false) @map("stop_on_match")
  active                Boolean               @default(true) @map("active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  configVersion         AkinatorConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Cascade)

  @@unique([configVersionId, code], name: "akinator_version_rule_code_unique")
  @@index([configVersionId])
  @@index([priorityOrder])
  @@map("akinator_rules")
}

model AkinatorSession {
  id                String                    @id @default(uuid())
  /// SHA-256 hash of raw session token (never store raw token)
  sessionTokenHash  String                    @unique @map("session_token_hash") @db.VarChar(64)
  configVersionId   String                    @map("config_version_id")
  sourceType        AkinatorSessionSourceType @default(PUBLIC_WALK_IN) @map("source_type")
  customerId        String?                   @map("customer_id")
  createdById       String?                   @map("created_by_id")
  quizStatus        AkinatorQuizStatus        @default(IN_PROGRESS) @map("quiz_status")
  workflowStatus    AkinatorWorkflowStatus?   @map("workflow_status")
  rawFullName       String?                   @map("raw_full_name")
  rawPhone          String?                   @map("raw_phone")
  rawEmail          String?                   @map("raw_email")
  startedAt         DateTime?                 @default(now()) @map("started_at")
  lastAccessedAt    DateTime?                 @map("last_accessed_at")
  completedAt       DateTime?                 @map("completed_at")
  expiresAt         DateTime?                 @map("expires_at")
  revokedAt         DateTime?                 @map("revoked_at")
  revokedById       String?                   @map("revoked_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  configVersion     AkinatorConfigVersion     @relation(fields: [configVersionId], references: [id], onDelete: Restrict)
  customer          Customer?                 @relation("CustomerAkinatorSessions", fields: [customerId], references: [id], onDelete: SetNull)
  createdBy         User?                     @relation("UserCreatedAkinatorSessions", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy         User?                     @relation("UserRevokedAkinatorSessions", fields: [revokedById], references: [id], onDelete: SetNull)
  rawAnswers        AkinatorRawAnswer[]
  result            AkinatorResult?
  adminReview       AkinatorAdminReview?
  statusHistories   AkinatorStatusHistory[]

  @@index([configVersionId])
  @@index([sourceType])
  @@index([customerId, quizStatus, completedAt])
  @@index([customerId, createdAt])
  @@index([createdById])
  @@index([quizStatus])
  @@index([workflowStatus])
  @@index([rawPhone])
  @@index([completedAt])
  @@map("akinator_sessions")
}

model AkinatorRawAnswer {
  id                   String           @id @default(uuid())
  sessionId            String           @map("session_id")
  questionId           String           @map("question_id")
  questionCode         String           @map("question_code")
  questionTextSnapshot String           @map("question_text_snapshot") @db.Text
  answerValue          Json             @map("answer_value")
  answerLabelSnapshot  String?          @map("answer_label_snapshot") @db.Text
  selectionReason      String?          @map("selection_reason") @db.Text
  stepOrder            Int              @default(1) @map("step_order")
  answeredAt           DateTime         @default(now()) @map("answered_at")

  session              AkinatorSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question             AkinatorQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionCode], name: "akinator_session_question_code_unique")
  @@index([sessionId])
  @@index([questionId])
  @@map("akinator_raw_answers")
}

model AkinatorResult {
  id                   String                   @id @default(uuid())
  sessionId            String                   @unique @map("session_id")
  configVersionId      String                   @map("config_version_id")
  evaluationStatus     AkinatorEvaluationStatus @map("evaluation_status")
  summaryTitle         String                   @map("summary_title")
  summaryDescription   String                   @map("summary_description") @db.Text
  outcomeData          Json                     @map("outcome_data")
  missingCriteria      Json                     @map("missing_criteria")
  matchedRulesSnapshot Json                     @map("matched_rules_snapshot")
  answersSnapshot      Json                     @map("answers_snapshot")
  disclaimerText       String                   @map("disclaimer_text") @db.Text
  generatedAt          DateTime                 @default(now()) @map("generated_at")

  session              AkinatorSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([configVersionId])
  @@index([evaluationStatus])
  @@map("akinator_results")
}

model AkinatorAdminReview {
  id                 String          @id @default(uuid())
  sessionId          String          @unique @map("session_id")
  editedFullName     String?         @map("edited_full_name")
  editedPhone        String?         @map("edited_phone")
  editedEmail        String?         @map("edited_email")
  editedGender       Gender?         @map("edited_gender")
  editedDateOfBirth  DateTime?       @map("edited_date_of_birth")
  editedAddress      String?         @map("edited_address")
  editedSource       String?         @map("edited_source")
  editedPriority     PriorityLevel?  @map("edited_priority")
  processorNote      String?         @map("processor_note") @db.Text
  missingInfoNote    String?         @map("missing_info_note") @db.Text
  approvalNote       String?         @map("approval_note") @db.Text
  rejectionReason    String?         @map("rejection_reason") @db.Text
  assignedAdminId    String?         @map("assigned_admin_id")
  approvedById       String?         @map("approved_by_id")
  approvedAt         DateTime?       @map("approved_at")
  rejectedById       String?         @map("rejected_by_id")
  rejectedAt         DateTime?       @map("rejected_at")
  linkedCustomerId   String?         @map("linked_customer_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  session            AkinatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([editedPhone])
  @@index([assignedAdminId])
  @@index([approvedById])
  @@index([linkedCustomerId])
  @@map("akinator_admin_reviews")
}

model AkinatorStatusHistory {
  id                    String                  @id @default(uuid())
  sessionId             String                  @map("session_id")
  fromStatus            AkinatorWorkflowStatus? @map("from_status")
  toStatus              AkinatorWorkflowStatus  @map("to_status")
  actionType            String                  @map("action_type")
  changedFieldsSnapshot Json?                   @map("changed_fields_snapshot")
  note                  String?                 @map("note") @db.Text
  actorUserId           String?                 @map("actor_user_id")
  actorEmail            String?                 @map("actor_email")
  createdAt             DateTime                @default(now()) @map("created_at")

  session               AkinatorSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([toStatus])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("akinator_status_histories")
}


