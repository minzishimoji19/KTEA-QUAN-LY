datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerStatus {
  LEAD_MOI
  DANG_TIEP_CAN
  DANG_TU_VAN
  THANH_CONG
  KHONG_KHA_THI
}

enum PriorityLevel {
  CHUA_CO_NHU_CAU
  THANH_KHOAN
  TIN_DUNG
  THANH_KHOAN_TIN_DUNG
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DROPPED
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum CaseProgress {
  NOT_SELECTED
  REGISTRATION_CREATED
  REGISTRATION_COMPLETED
  UNDER_REVIEW
  APPROVED
  CARD_ISSUED
  CARD_ACTIVATED
  COMPLETED
}

enum ActivityType {
  CONTACT
  CALL
  MESSAGE
  MEETING
  APPLICATION_CREATED
  APPLICATION_UPDATED
  STATUS_CHANGED
  NEED_DETECTED
  FOLLOW_UP
  PUSH_CREATED
  PUSH_RESULT
  NOTE_CREATED
  SYSTEM_EVENT
  PUSH_SENT
  NOTE
  CREATE_CASE
  SELECT_PRODUCT
  PROGRESS_CHANGED
  REJECTED
  APPROVED
  CARD_ISSUED
  CARD_ACTIVATED
  COMPLETED
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecommendationStatus {
  NEW
  REVIEWED
  DISMISSED
  CONVERTED_TO_PUSH
  ACTIVE
  ACCEPTED
  EXPIRED
}

enum PushStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  CANCELLED
}

model CustomerSource {
  id          String     @id @default(uuid())
  name        String     @unique @map("name")
  active      Boolean    @default(true) @map("active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  customers   Customer[]

  @@map("customer_sources")
}

model Customer {
  id              String            @id @default(uuid())
  fullName        String            @map("full_name")
  phone           String            @map("phone")
  email           String?           @map("email")
  gender          Gender?           @map("gender")
  dateOfBirth     DateTime?         @map("date_of_birth")
  address         String?           @map("address")
  note            String?           @map("note") @db.Text
  source          String?           @map("source")
  sourceId        String?           @map("source_id")
  overallStatus   CustomerStatus    @default(LEAD_MOI) @map("overall_status")
  priority        PriorityLevel?    @default(CHUA_CO_NHU_CAU) @map("priority")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customerSource  CustomerSource?   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  needs           CustomerNeed[]
  cases           CustomerCase[]
  activities      CustomerActivity[]
  notes           CustomerNote[]
  customerTags    CustomerTag[]
  followUps       FollowUp[]
  recommendations Recommendation[]
  pushRecords     PushRecord[]
  assignments     CustomerAssignment[]
  assignmentGrants CustomerAssignmentGrant[]

  @@index([phone])
  @@index([sourceId])
  @@index([overallStatus])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("customers")
}

model Product {
  id              String            @id @default(uuid())
  code            String            @unique @map("code")
  name            String            @map("name")
  description     String?           @map("description") @db.Text
  active          Boolean           @default(true) @map("active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  cases           CustomerCase[]
  recommendations Recommendation[]
  pushRecords     PushRecord[]

  @@map("products")
}

model CustomerNeed {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  needType        String            @map("need_type")
  status          NeedStatus        @default(OPEN) @map("status")
  detectedAt      DateTime          @default(now()) @map("detected_at")
  resolvedAt      DateTime?         @map("resolved_at")
  notes           String?           @map("notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("customer_needs")
}

model CustomerCase {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  productId       String?           @map("product_id")
  caseStatus      CaseStatus        @default(ACTIVE) @map("case_status")
  progress        CaseProgress      @default(NOT_SELECTED) @map("progress")
  applicationDate DateTime?         @map("application_date")
  resultDate      DateTime?         @map("result_date")
  rejectedAt      DateTime?         @map("rejected_at")
  rejectionReason String?           @map("rejection_reason") @db.Text
  rejectionNote   String?           @map("rejection_note") @db.Text
  failureReason   String?           @map("failure_reason") @db.Text
  notes           String?           @map("notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  progressHistory CaseProgressHistory[]

  @@index([customerId])
  @@index([productId])
  @@index([caseStatus])
  @@index([progress])
  @@index([createdAt])
  @@map("customer_cases")
}

model CaseProgressHistory {
  id           String        @id @default(uuid())
  caseId       String        @map("case_id")
  fromProgress CaseProgress? @map("from_progress")
  toProgress   CaseProgress  @map("to_progress")
  changedAt    DateTime      @default(now()) @map("changed_at")
  note         String?       @map("note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  case         CustomerCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([toProgress])
  @@index([changedAt])
  @@map("case_progress_histories")
}

model CustomerActivity {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  type            ActivityType      @map("type")
  title           String            @map("title")
  description     String?           @map("description") @db.Text
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([occurredAt])
  @@map("customer_activities")
}

model CustomerNote {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  content         String            @map("content") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

model Tag {
  id              String            @id @default(uuid())
  name            String            @unique @map("name")
  color           String?           @map("color")
  createdAt       DateTime          @default(now()) @map("created_at")

  customerTags    CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId      String            @map("customer_id")
  tagId           String            @map("tag_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag             Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

model FollowUp {
  id              String            @id @default(uuid())
  customerId      String            @map("customer_id")
  title           String            @map("title")
  description     String?           @map("description") @db.Text
  dueAt           DateTime          @map("due_at")
  status          FollowUpStatus    @default(PENDING) @map("status")
  completedAt     DateTime?         @map("completed_at")
  assignedTo      String?           @map("assigned_to")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dueAt])
  @@index([status])
  @@map("follow_ups")
}

model Recommendation {
  id                 String               @id @default(uuid())
  customerId         String               @map("customer_id")
  targetProductId    String?              @map("target_product_id")
  recommendationType String               @map("recommendation_type")
  score              Decimal?             @map("score") @db.Decimal(5, 2)
  reason             String               @map("reason") @db.Text
  status             RecommendationStatus @default(NEW) @map("status")
  generatedAt        DateTime             @default(now()) @map("generated_at")
  dismissedAt        DateTime?            @map("dismissed_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  targetProduct      Product?             @relation(fields: [targetProductId], references: [id], onDelete: SetNull)
  pushRecords        PushRecord[]

  @@index([customerId])
  @@index([targetProductId])
  @@index([status])
  @@map("recommendations")
}

model PushRecord {
  id                 String            @id @default(uuid())
  customerId         String            @map("customer_id")
  recommendationId   String?           @map("recommendation_id")
  targetProductId    String?           @map("target_product_id")
  pushedAt           DateTime          @default(now()) @map("pushed_at")
  status             PushStatus        @default(PENDING) @map("status")
  resultAt           DateTime?         @map("result_at")
  failureReason      String?           @map("failure_reason") @db.Text
  note               String?           @map("note") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recommendation     Recommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  targetProduct      Product?          @relation(fields: [targetProductId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([targetProductId])
  @@index([recommendationId])
  @@index([status])
  @@index([pushedAt])
  @@map("push_records")
}

model PushSubscription {
  id         String   @id @default(uuid())
  recipient  String   @map("recipient")
  endpoint   String   @unique @map("endpoint") @db.VarChar(500)
  p256dh     String   @map("p256dh") @db.VarChar(255)
  auth       String   @map("auth") @db.VarChar(255)
  deviceName String?  @map("device_name")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([recipient])
  @@map("push_subscriptions")
}

model PushNotificationLog {
  id           String   @id @default(uuid())
  followUpId   String?  @map("follow_up_id")
  eventType    String   @map("event_type")
  recipient    String   @map("recipient")
  status       String   @default("SENT") @map("status")
  title        String   @map("title")
  body         String?  @map("body") @db.Text
  errorMessage String?  @map("error_message") @db.Text
  sentAt       DateTime @default(now()) @map("sent_at")

  @@unique([followUpId, eventType, recipient])
  @@index([followUpId])
  @@index([recipient])
  @@index([sentAt])
  @@map("push_notification_logs")
}

model Caretaker {
  id        String   @id @default(uuid())
  name      String   @unique @map("name")
  active    Boolean  @default(true) @map("active")
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("caretakers")
}

enum Role {
  ADMIN
  PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @map("email")
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         Role       @default(PARTNER) @map("role")
  status       UserStatus @default(ACTIVE) @map("status")
  phone        String?    @map("phone")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignedCustomers  CustomerAssignment[] @relation("AssignedPartner")
  createdAssignments CustomerAssignment[] @relation("AssignedByAdmin")
  receivedGrants     CustomerAssignmentGrant[] @relation("PartnerAssignmentGrants")
  createdGrants      CustomerAssignmentGrant[] @relation("AdminAssignmentGrants")
  auditLogs          AuditLog[]
  caretaker          Caretaker?

  @@map("users")
}

model CustomerAssignment {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  userId       String   @map("user_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  notes        String?  @map("notes") @db.Text

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("AssignedPartner", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssignedByAdmin", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([customerId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("customer_assignments")
}

enum AssignmentSourceType {
  DIRECT
  CARE_SCHEDULE
}

model CustomerAssignmentGrant {
  id           String               @id @default(uuid())
  customerId   String               @map("customer_id")
  userId       String               @map("user_id")
  sourceType   AssignmentSourceType @map("source_type")
  sourceId     String               @default("DIRECT") @map("source_id")
  active       Boolean              @default(true) @map("active")
  assignedById String?              @map("assigned_by_id")
  notes        String?              @map("notes") @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("PartnerAssignmentGrants", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AdminAssignmentGrants", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([customerId, userId, sourceType, sourceId], name: "customer_user_source_unique")
  @@index([userId])
  @@index([customerId])
  @@index([sourceId])
  @@index([active])
  @@map("customer_assignment_grants")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?  @map("details") @db.Text
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

