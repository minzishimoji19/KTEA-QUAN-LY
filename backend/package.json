{
  "name": "ktea-crm-backend",
  "version": "1.0.0",
  "description": "Customer Management & Intelligence System - Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:start": "powershell -ExecutionPolicy Bypass -File ../scripts/start-db.ps1",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "test:domain": "tsx src/tests/verify-domain.ts",
    "test:api": "tsx src/tests/verify-api.ts",
    "test:analytics": "tsx src/tests/verify-analytics.ts",
    "test:recommendations": "tsx src/tests/verify-recommendation-engine.ts",
    "test:lifecycle": "tsx src/tests/verify-case-lifecycle-and-sources.ts",
    "test:settings": "tsx src/tests/verify-settings.ts",
    "test:source-filter": "tsx src/tests/verify-customer-source-filter.ts",
    "test": "tsx src/tests/verify-case-lifecycle-and-sources.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prisma": "^5.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
